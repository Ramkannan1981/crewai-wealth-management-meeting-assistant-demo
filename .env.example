# Copy this file to .env and fill in ONE of the following, depending on
# which model provider you want to use. See README for details.

# Option A: Anthropic (the default; requires the crewai[anthropic] extra,
# which requirements.txt already installs)
ANTHROPIC_API_KEY=

# Option B: OpenAI (also set CREWAI_MODEL below, and install crewai[openai])
OPENAI_API_KEY=

# Optional: override the model used by the agent, as a "provider/model-name"
# string. Model names change frequently -- check your provider's current docs.
# Default if unset: anthropic/claude-sonnet-4-5
CREWAI_MODEL=
